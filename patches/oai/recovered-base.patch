+    if ((packet_address[i] & mask[i]) != (rule_address[i] & mask[i]))
+      return false;
+  }
+  return true;
+}
+
+static bool packet_filter_matches(const nr_sdap_qos_packet_filter_t *filter, const uint8_t *packet, size_t length)
+{
+  if (filter->direction != 2 && filter->direction != 3)
+    return false;
+  if (length < 20 || (packet[0] >> 4) != 4)
+    return false;
+  size_t header_length = (packet[0] & 0x0f) * 4;
+  if (header_length < 20 || length < header_length)
+    return false;
+  uint8_t protocol = packet[9];
+  if (filter->has_local_ipv4 && !masked_ipv4_equal(packet + 12, filter->local_ipv4, filter->local_ipv4_mask))
+    return false;
+  if (filter->has_remote_ipv4 && !masked_ipv4_equal(packet + 16, filter->remote_ipv4, filter->remote_ipv4_mask))
+    return false;
+  if (filter->has_protocol && protocol != filter->protocol)
+    return false;
+  if (filter->has_local_ports || filter->has_remote_ports) {
+    if ((protocol != IPPROTO_TCP && protocol != IPPROTO_UDP) || length < header_length + 4)
+      return false;
+    uint16_t local_port = ((uint16_t)packet[header_length] << 8) | packet[header_length + 1];
+    uint16_t remote_port = ((uint16_t)packet[header_length + 2] << 8) | packet[header_length + 3];
+    if (filter->has_local_ports && (local_port < filter->local_port_low || local_port > filter->local_port_high))
+      return false;
+    if (filter->has_remote_ports && (remote_port < filter->remote_port_low || remote_port > filter->remote_port_high))
+      return false;
+  }
+  return filter->match_all || filter->has_local_ipv4 || filter->has_remote_ipv4 || filter->has_protocol ||
+         filter->has_local_ports || filter->has_remote_ports;
