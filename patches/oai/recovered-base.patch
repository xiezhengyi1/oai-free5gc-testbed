 typedef int (*ngap_message_decoded_callback)(sctp_assoc_t assoc_id, uint32_t stream, NGAP_NGAP_PDU_t *pdu);
 
 /* Handlers matrix. Only gNB related procedure present here */
+/* Store the policy in NGAP and dispatch the RAN-local mapping on the RRC task. */
+static int ngap_gNB_handle_rfsp_modification(sctp_assoc_t assoc_id, uint32_t stream, NGAP_NGAP_PDU_t *pdu)
+{
+  NGAP_UEContextModificationRequest_t *request = &pdu->choice.initiatingMessage->value.choice.UEContextModificationRequest;
+  NGAP_UEContextModificationRequestIEs_t *ie;
+  NGAP_FIND_PROTOCOLIE_BY_ID(NGAP_UEContextModificationRequestIEs_t, ie, request, NGAP_ProtocolIE_ID_id_AMF_UE_NGAP_ID, true);
+  unsigned long amf_id;
+  if (asn_INTEGER2ulong(&ie->value.choice.AMF_UE_NGAP_ID, &amf_id)) return -1;
+  NGAP_FIND_PROTOCOLIE_BY_ID(NGAP_UEContextModificationRequestIEs_t, ie, request, NGAP_ProtocolIE_ID_id_RAN_UE_NGAP_ID, true);
+  uint32_t ran_id = ie->value.choice.RAN_UE_NGAP_ID;
+  ngap_gNB_ue_context_t *ue = ngap_get_ue_context(ran_id);
+  if (!ue || ue->amf_ue_ngap_id != amf_id || ue->amf_ref->assoc_id != assoc_id) return -1;
+  for (int i=0; i<request->protocolIEs.list.count; i++) {
+    ie=request->protocolIEs.list.array[i];
+    if (ie->id!=NGAP_ProtocolIE_ID_id_AMF_UE_NGAP_ID && ie->id!=NGAP_ProtocolIE_ID_id_RAN_UE_NGAP_ID &&
+        ie->criticality==NGAP_Criticality_reject) {
+      NGAP_ERROR("Unsupported mandatory UEContextModification IE %ld\n",ie->id);
+      return -1;
+    }
+  }
+  NGAP_FIND_PROTOCOLIE_BY_ID(NGAP_UEContextModificationRequestIEs_t, ie, request, NGAP_ProtocolIE_ID_id_IndexToRFSP, true);
+  if (ie->value.choice.IndexToRFSP<1 || ie->value.choice.IndexToRFSP>256) return -1;
+  ue->index_to_rfsp=ie->value.choice.IndexToRFSP;
+  NGAP_NGAP_PDU_t response={.present=NGAP_NGAP_PDU_PR_successfulOutcome};
+  asn1cCalloc(response.choice.successfulOutcome, outcome);
+  outcome->procedureCode=NGAP_ProcedureCode_id_UEContextModification;
+  outcome->criticality=NGAP_Criticality_reject;
+  outcome->value.present=NGAP_SuccessfulOutcome__value_PR_UEContextModificationResponse;
+  NGAP_UEContextModificationResponse_t *body=&outcome->value.choice.UEContextModificationResponse;
+  {
+    asn1cSequenceAdd(body->protocolIEs.list, NGAP_UEContextModificationResponseIEs_t, field);
+    field->id=NGAP_ProtocolIE_ID_id_AMF_UE_NGAP_ID;
+    field->criticality=NGAP_Criticality_ignore;
+    field->value.present=NGAP_UEContextModificationResponseIEs__value_PR_AMF_UE_NGAP_ID;
+    asn_ulong2INTEGER(&field->value.choice.AMF_UE_NGAP_ID,amf_id);
+  }
+  {
+    asn1cSequenceAdd(body->protocolIEs.list, NGAP_UEContextModificationResponseIEs_t, field);
+    field->id=NGAP_ProtocolIE_ID_id_RAN_UE_NGAP_ID;
+    field->criticality=NGAP_Criticality_ignore;
+    field->value.present=NGAP_UEContextModificationResponseIEs__value_PR_RAN_UE_NGAP_ID;
+    field->value.choice.RAN_UE_NGAP_ID=ran_id;
+  }
+  uint8_t *buffer; uint32_t length;
+  int status=ngap_gNB_encode_pdu(&response,&buffer,&length);
+  ASN_STRUCT_FREE_CONTENTS_ONLY(asn_DEF_NGAP_NGAP_PDU,&response);
+  if (status<0) return -1;
+  ngap_gNB_itti_send_sctp_data_req(ue->gNB_instance->instance,assoc_id,buffer,length,ue->tx_stream);
+  MessageDef *rfsp_msg = itti_alloc_new_message(TASK_NGAP, 0, NGAP_RFSP_UPDATE);
+  NGAP_RFSP_UPDATE(rfsp_msg).gNB_ue_ngap_id = ran_id;
+  NGAP_RFSP_UPDATE(rfsp_msg).rfsp_index = ue->index_to_rfsp;
+  itti_send_msg_to_task(TASK_RRC_GNB, ue->gNB_instance->instance, rfsp_msg);
+  NGAP_INFO("RFSP_POLICY ran_ue_id=%u rfsp=%u response=sent radio_mapping=pending_rrc\n",ran_id,ue->index_to_rfsp);
+  return 0;
+}
