diff --git a/openair3/NAS/NR_UE/test_ue_policy.c b/openair3/NAS/NR_UE/test_ue_policy.c
new file mode 100644
index 0000000..4b0db82
--- /dev/null
+++ b/openair3/NAS/NR_UE/test_ue_policy.c
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: LicenseRef-CSSL-1.0 */
+#include "ue_policy.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+int main(int argc,char **argv)
+{
+  assert(argc==2);
+  FILE *file=fopen(argv[1],"rb"); assert(file);
+  uint8_t bytes[65536]; size_t n=fread(bytes,1,sizeof(bytes),file); fclose(file);
+  ue_policy_t policy;
+  assert(ue_policy_decode(bytes,n,&policy)==0);
+  assert(policy.rule_count==1 && policy.upsc==1 && policy.pti==1);
+  const ue_policy_rule_t *rule=ue_policy_match(&policy,0x01020304,17,5000);
+  assert(rule && !strcmp(rule->routes[0].dnn,"internet") && rule->routes[0].sd==0x010203);
+  uint8_t result[13]; assert(ue_policy_result(&policy,true,result)==2 && result[1]==2);
+  assert(ue_policy_result(&policy,false,result)==13 && result[12]==0x6f);
+  for (size_t i=0;i<n;i++) assert(ue_policy_decode(bytes,i,&policy)!=0);
+  for (size_t i=0;i<n;i++) {
+    for (unsigned bit=1;bit<256;bit<<=1) {
+      bytes[i]^=bit; ue_policy_decode(bytes,n,&policy); bytes[i]^=bit;
+    }
+  }
+  bytes[0]=0; assert(ue_policy_decode(bytes,n,&policy)!=0);
+  puts("UE policy wire decoder, classifier, result and truncation tests passed");
+}
diff --git a/openair3/NAS/NR_UE/ue_policy.c b/openair3/NAS/NR_UE/ue_policy.c
new file mode 100644
index 0000000..175934a
--- /dev/null
+++ b/openair3/NAS/NR_UE/ue_policy.c
@@ -0,0 +1,159 @@
+/* SPDX-License-Identifier: LicenseRef-CSSL-1.0 */
+#include "ue_policy.h"
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef struct { const uint8_t *p; size_t n; } cursor_t;
+static int take(cursor_t *c, size_t n, cursor_t *out)
+{
+  if (n > c->n) return -1;
+  *out = (cursor_t){c->p,n}; c->p += n; c->n -= n; return 0;
+}
+static int u8(cursor_t *c, uint8_t *out)
+{
+  if (!c->n) return -1;
+  *out = *c->p++; --c->n; return 0;
+}
+static int u16(cursor_t *c, uint16_t *out)
+{
+  if (c->n < 2) return -1;
+  *out = ((uint16_t)c->p[0] << 8) | c->p[1]; c->p += 2; c->n -= 2; return 0;
+}
+static int lv(cursor_t *c, cursor_t *out)
+{
+  uint16_t n; return u16(c,&n) || take(c,n,out) ? -1 : 0;
+}
+static uint32_t be32(const uint8_t *p)
+{
+  return (uint32_t)p[0]<<24 | (uint32_t)p[1]<<16 | (uint32_t)p[2]<<8 | p[3];
+}
+static int decode_dnn(cursor_t c, char out[101])
+{
+  size_t used=0;
+  while (c.n) {
+    uint8_t n; cursor_t label;
+    if (u8(&c,&n) || !n || n>63 || take(&c,n,&label) || used+n+(used!=0)>100) return -1;
+    if (used) out[used++]='.';
+    for (size_t i=0;i<n;i++) {
+      uint8_t ch=label.p[i];
+      if (!((ch>='a'&&ch<='z') || (ch>='0'&&ch<='9') || ch=='-')) return -1;
+      out[used++]=ch;
+    }
+  }
+  out[used]=0; return used ? 0 : -1;
+}
+static int decode_route(cursor_t c, ue_policy_route_t *route)
+{
+  cursor_t contents;
+  route->sd=0xffffff;
+  if (u8(&c,&route->precedence) || lv(&c,&contents) || c.n) return -1;
+  bool got_slice=false,got_dnn=false;
+  while (contents.n) {
+    uint8_t type,n; cursor_t value;
+    if (u8(&contents,&type) || u8(&contents,&n) || take(&contents,n,&value)) return -1;
+    if (type==2) {
+      if (got_slice || (n!=1 && n!=4)) return -1;
+      got_slice=true; route->sst=value.p[0];
+      if (n==4) route->sd=(uint32_t)value.p[1]<<16 | (uint32_t)value.p[2]<<8 | value.p[3];
+    } else if (type==4) {
+      if (got_dnn || decode_dnn(value,route->dnn)) return -1;
+      got_dnn=true;
+    } else { return -1; }
+  }
+  return got_slice && got_dnn ? 0 : -1;
+}
+static int decode_rule(cursor_t c, ue_policy_rule_t *rule)
+{
+  cursor_t td,rsds;
+  if (u8(&c,&rule->precedence) || lv(&c,&td) || !td.n || lv(&c,&rsds) || c.n) return -1;
+  unsigned fields=0;
+  while (td.n) {
+    uint8_t type; cursor_t value;
+    if (u8(&td,&type)) return -1;
+    switch (type) {
+      case 1: if (fields || td.n) return -1; fields=1; break;
+      case 0x10:
+        if ((fields&3) || take(&td,8,&value)) return -1;
+        fields|=2; rule->address=be32(value.p); rule->mask=be32(value.p+4); break;
+      case 0x30:
+        if ((fields&5) || u8(&td,&rule->protocol)) return -1;
+        fields|=4; break;
+      case 0x50:
+        if ((fields&9) || u16(&td,&rule->port)) return -1;
+        fields|=8; break;
+      default: return -1;
+    }
+  }
+  while (rsds.n) {
+    cursor_t rsd;
+    if (rule->route_count==UE_POLICY_MAX_ROUTES || lv(&rsds,&rsd)) return -1;
+    ue_policy_route_t *route=&rule->routes[rule->route_count++];
+    if (decode_route(rsd,route)) return -1;
+    for (size_t j=0;j+1<rule->route_count;j++)
+      if (rule->routes[j].precedence==route->precedence) return -1;
+  }
+  return rule->route_count ? 0 : -1;
+}
+int ue_policy_decode(const uint8_t *data, size_t size, ue_policy_t *out)
+{
+  ue_policy_t policy={0};
+  cursor_t c={data,size},list,sublist,plmn,instruction,rules;
+  uint8_t type; uint16_t part_length;
+  if (u8(&c,&policy.pti) || !policy.pti || policy.pti==255 || u8(&c,&type) || type!=1 || lv(&c,&list)) return -1;
+  /* Profile: one PLMN / one policy section / one URSP part, up to 32 rules. */
+  if (lv(&list,&sublist) || list.n || take(&sublist,3,&plmn) || lv(&sublist,&instruction) || sublist.n || u16(&instruction,&policy.upsc)) return -1;
+  memcpy(policy.plmn,plmn.p,3);
+  if (!instruction.n) { *out=policy; return 0; } /* Delete section. */
+  if (u16(&instruction,&part_length) || !part_length || u8(&instruction,&type) || type!=1 || take(&instruction,part_length-1,&rules) || instruction.n) return -1;
+  while (rules.n) {
+    cursor_t rule;
+    if (policy.rule_count==UE_POLICY_MAX_RULES || lv(&rules,&rule)) return -1;
+    ue_policy_rule_t *decoded=&policy.rules[policy.rule_count++];
+    if (decode_rule(rule,decoded)) return -1;
+    for (size_t j=0;j+1<policy.rule_count;j++)
+      if (policy.rules[j].precedence==decoded->precedence) return -1;
+  }
+  if (!policy.rule_count) return -1;
+  *out=policy; return 0;
+}
+const ue_policy_rule_t *ue_policy_match(const ue_policy_t *policy,uint32_t ipv4,uint8_t protocol,uint16_t port)
+{
+  const ue_policy_rule_t *best=NULL;
+  for (size_t i=0;i<policy->rule_count;i++) {
+    const ue_policy_rule_t *r=&policy->rules[i];
+    if ((ipv4&r->mask)!=(r->address&r->mask) || (r->protocol && r->protocol!=protocol) || (r->port && r->port!=port)) continue;
+    if (!best || r->precedence<best->precedence) best=r;
+  }
+  return best;
+}
+int ue_policy_save(const char *path,const uint8_t *data,size_t size)
+{
+  char temp[4096];
+  if (snprintf(temp,sizeof(temp),"%s.tmp",path)>=(int)sizeof(temp)) return -1;
+  FILE *f=fopen(temp,"wb");
+  if (!f) return -1;
+  int status=fwrite(data,1,size,f)==size && fflush(f)==0 && fsync(fileno(f))==0 ? 0 : -1;
+  if (fclose(f)!=0) status=-1;
+  if (status==0) status=rename(temp,path);
+  if (status!=0) unlink(temp);
+  return status;
+}
+int ue_policy_load(const char *path,ue_policy_t *out)
+{
+  FILE *f=fopen(path,"rb");
+  if (!f) return errno==ENOENT ? 1 : -1;
+  uint8_t data[65536]; size_t n=fread(data,1,sizeof(data),f);
+  int status=ferror(f) || n==sizeof(data) ? -1 : ue_policy_decode(data,n,out);
+  fclose(f); return status;
+}
+size_t ue_policy_result(const ue_policy_t *p,bool accepted,uint8_t out[13])
+{
+  out[0]=p->pti; out[1]=accepted?2:3;
+  if (accepted) return 2;
+  out[2]=0;out[3]=9;out[4]=1;memcpy(out+5,p->plmn,3);
+  out[8]=p->upsc>>8;out[9]=p->upsc;out[10]=0;out[11]=1;out[12]=0x6f;
+  return 13;
+}
diff --git a/openair3/NAS/NR_UE/ue_policy.h b/openair3/NAS/NR_UE/ue_policy.h
new file mode 100644
index 0000000..4da0c12
--- /dev/null
+++ b/openair3/NAS/NR_UE/ue_policy.h
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: LicenseRef-CSSL-1.0 */
+#ifndef OAI_UE_POLICY_H
+#define OAI_UE_POLICY_H
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define UE_POLICY_MAX_RULES 32
+#define UE_POLICY_MAX_ROUTES 8
+typedef struct {
+  uint8_t precedence, sst;
+  uint32_t sd;
+  char dnn[101];
+} ue_policy_route_t;
+typedef struct {
+  uint8_t precedence, protocol;
+  uint16_t port;
+  uint32_t address, mask;
+  size_t route_count;
+  ue_policy_route_t routes[UE_POLICY_MAX_ROUTES];
+} ue_policy_rule_t;
+typedef struct {
+  uint8_t pti, plmn[3];
+  uint16_t upsc;
+  size_t rule_count;
+  ue_policy_rule_t rules[UE_POLICY_MAX_RULES];
+} ue_policy_t;
+
+/* All cursor checks enforce the external NAS wire boundary. */
+int ue_policy_decode(const uint8_t *data, size_t size, ue_policy_t *out);
+const ue_policy_rule_t *ue_policy_match(const ue_policy_t *policy, uint32_t ipv4, uint8_t protocol, uint16_t port);
+int ue_policy_save(const char *path, const uint8_t *data, size_t size);
+int ue_policy_load(const char *path, ue_policy_t *out);
+size_t ue_policy_result(const ue_policy_t *policy, bool accepted, uint8_t out[13]);
+#endif
diff --git a/openair3/NAS/NR_UE/ue_policy_service.c b/openair3/NAS/NR_UE/ue_policy_service.c
new file mode 100644
index 0000000..f0fced1
--- /dev/null
+++ b/openair3/NAS/NR_UE/ue_policy_service.c
@@ -0,0 +1,144 @@
+/* SPDX-License-Identifier: LicenseRef-CSSL-1.0 */
+#include "ue_policy_service.h"
+#include <arpa/inet.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <time.h>
+
+void ue_policy_write_state(nr_ue_nas_t *nas)
+{
+  if (!nas->policy_dynamic_pdu) return;
+  char path[560], temporary[564];
+  snprintf(path,sizeof(path),"%s.state.json",nas->policy_path);
+  snprintf(temporary,sizeof(temporary),"%s.tmp",path);
+  FILE *file=fopen(temporary,"w");
+  AssertFatal(file,"Cannot write UE NAS state: %s\n",strerror(errno));
+  fprintf(file,"{\"source\":\"oai_ue_nas\",\"allowed_nssai\":[");
+  for (int i=0;i<nas->policy_allowed_count;i++)
+    fprintf(file,"%s{\"sst\":%d,\"sd\":\"%06x\"}",i?",":"",nas->policy_allowed_nssai[i].sst,nas->policy_allowed_nssai[i].sd);
+  fprintf(file,"],\"sessions\":[");
+  for (int i=0;i<nas->uicc->n_pdu_sessions;i++) {
+    const pdu_session_config_t *p=&nas->uicc->pdu_sessions[i];
+    fprintf(file,"%s{\"id\":%d,\"dnn\":\"%s\",\"sst\":%d,\"sd\":\"%06x\",\"active\":%s,\"pending\":%s,\"error\":%d}",
+            i?",":"",p->id,p->dnn,p->nssai.sst,p->nssai.sd,
+            nas->policy_session_active[p->id]?"true":"false",nas->policy_session_pending[p->id]?"true":"false",nas->policy_session_error[p->id]);
+  }
+  fprintf(file,"]}\n");
+  AssertFatal(fclose(file)==0 && rename(temporary,path)==0,"Cannot commit UE NAS state\n");
+}
+
+static int select_session(nr_ue_nas_t *nas,const ue_policy_rule_t *rule)
+{
+  const ue_policy_route_t *route=NULL;
+  for (size_t j=0;j<rule->route_count;j++) {
+    const ue_policy_route_t *candidate=&rule->routes[j];
+    bool allowed=false;
+    if (!nas->policy_dynamic_pdu) {
+      for (int i=0;i<nas->uicc->n_pdu_sessions;i++) {
+        const pdu_session_config_t *p=&nas->uicc->pdu_sessions[i];
+        if (!strcmp(p->dnn,candidate->dnn) && p->nssai.sst==candidate->sst && p->nssai.sd==candidate->sd
+            && nas->policy_session_active[p->id]) allowed=true;
+      }
+    } else {
+      for (int i=0;i<nas->policy_allowed_count;i++)
+        if (nas->policy_allowed_nssai[i].sst==candidate->sst &&
+            nas->policy_allowed_nssai[i].sd==candidate->sd) allowed=true;
+    }
+    if (allowed && (!route || candidate->precedence<route->precedence)) route=candidate;
+  }
+  if (!route) return -1;
+  for (int i=0;i<nas->uicc->n_pdu_sessions;i++) {
+    const pdu_session_config_t *p=&nas->uicc->pdu_sessions[i];
+    if (!strcmp(p->dnn,route->dnn) && p->nssai.sst==route->sst && p->nssai.sd==route->sd) return i;
+  }
+  if (!nas->policy_dynamic_pdu) return -1;
+  int id;
+  for (id=1;id<16;id++) {
+    bool used=false;
+    for (int i=0;i<nas->uicc->n_pdu_sessions;i++) used|=nas->uicc->pdu_sessions[i].id==id;
+    if (!used) break;
+  }
+  if (id==16) return -1;
+  int index=nas->uicc->n_pdu_sessions++;
+  nas->uicc->pdu_sessions[index]=(pdu_session_config_t){.id=id,.type=1,
+    .nssai={.sst=route->sst,.sd=route->sd},.dnn=strdup(route->dnn)};
+  AssertFatal(nas->uicc->pdu_sessions[index].dnn,"Cannot allocate PDU DNN\n");
+  return index;
+}
+
+static void *serve(void *arg)
+{
+  nr_ue_nas_t *nas=arg;
+  int listener=socket(AF_UNIX,SOCK_STREAM,0);
+  AssertFatal(listener>=0,"UE policy socket: %s\n",strerror(errno));
+  struct sockaddr_un address={.sun_family=AF_UNIX};
+  int n=snprintf(address.sun_path,sizeof(address.sun_path),"%s.sock",nas->policy_path);
+  AssertFatal(n<(int)sizeof(address.sun_path),"UE policy socket path too long\n");
+  unlink(address.sun_path);
+  AssertFatal(bind(listener,(struct sockaddr *)&address,sizeof(address))==0,"UE policy bind: %s\n",strerror(errno));
+  AssertFatal(listen(listener,8)==0,"UE policy listen: %s\n",strerror(errno));
+  for (;;) {
+    int fd=accept(listener,NULL,NULL);
+    if (fd<0) { LOG_E(NAS,"UE policy accept: %s\n",strerror(errno)); break; }
+    struct timeval timeout={.tv_sec=2};
+    setsockopt(fd,SOL_SOCKET,SO_RCVTIMEO,&timeout,sizeof(timeout));
+    char query[128]={0},ip[INET_ADDRSTRLEN]; unsigned protocol,port;
+    ssize_t got=recv(fd,query,sizeof(query)-1,0);
+    struct in_addr ipv4;
+    if (got<=0 || sscanf(query,"%15s %u %u",ip,&protocol,&port)!=3 || protocol>255 || port>65535 || inet_pton(AF_INET,ip,&ipv4)!=1) {
+      send(fd,"ERROR invalid-query\n",20,MSG_NOSIGNAL); close(fd); continue;
+    }
+    pthread_mutex_lock(&nas->ue_policy_lock);
+    const ue_policy_rule_t *rule=ue_policy_match(&nas->ue_policy,ntohl(ipv4.s_addr),protocol,port);
+    int idx=rule?select_session(nas,rule):-1;
+    char response[256];
+    if (idx<0) {
+      snprintf(response,sizeof(response),"NO_ROUTE\n");
+    } else {
+      const pdu_session_config_t *pdu=&nas->uicc->pdu_sessions[idx];
+      int id=pdu->id;
+      if (nas->policy_dynamic_pdu && !nas->policy_session_active[id] && !nas->policy_session_pending[id] && !nas->policy_session_error[id]) {
+        nas->policy_session_pending[id]=true;
+        nas->policy_session_started[id]=time(NULL);
+        request_pdusession(nas,pdu);
+        LOG_I(NAS,"UE_POLICY PDU_REQUEST id=%d dnn=%s sst=%d sd=%06x\n",id,pdu->dnn,pdu->nssai.sst,pdu->nssai.sd);
+        ue_policy_write_state(nas);
+      }
+      if (nas->policy_session_pending[id] && time(NULL)-nas->policy_session_started[id]>30) {
+        nas->policy_session_pending[id]=false;
+        nas->policy_session_error[id]=-1;
+        ue_policy_write_state(nas);
+      }
+      if (nas->policy_session_error[id]) {
+        snprintf(response,sizeof(response),"FAILED %d %d\n",id,nas->policy_session_error[id]);
+      } else if (!nas->policy_session_active[pdu->id]) {
+        snprintf(response,sizeof(response),"PENDING %d\n",pdu->id);
+      } else {
+        char interface[32];
+        if (idx==0) snprintf(interface,sizeof(interface),"oaitun_ue%ld",nas->UE_id+1);
+        else snprintf(interface,sizeof(interface),"oaitun_ue%ldp%d",nas->UE_id+1,pdu->id);
+        snprintf(response,sizeof(response),"ROUTE %s %d %u %u %u\n",interface,pdu->id,rule->precedence,nas->ue_policy.upsc,nas->ue_policy.pti);
+      }
+    }
+    pthread_mutex_unlock(&nas->ue_policy_lock);
+    send(fd,response,strlen(response),MSG_NOSIGNAL);
+    close(fd);
+  }
+  close(listener); return NULL;
+}
+void ue_policy_service_start(nr_ue_nas_t *nas)
+{
+  pthread_mutex_init(&nas->ue_policy_lock,NULL);
+  const char *dir=getenv("OAI_UE_POLICY_DIR");
+  if (!dir) return;
+  int n=snprintf(nas->policy_path,sizeof(nas->policy_path),"%s/%s.policy",dir,nas->uicc->imsiStr);
+  AssertFatal(n<(int)sizeof(nas->policy_path),"UE policy storage path too long\n");
+  AssertFatal(ue_policy_load(nas->policy_path,&nas->ue_policy)>=0,"Cannot load UE policy file\n");
+  nas->policy_dynamic_pdu=getenv("OAI_UE_DYNAMIC_PDU") && !strcmp(getenv("OAI_UE_DYNAMIC_PDU"),"1");
+  for (int i=0;i<nas->uicc->n_pdu_sessions;i++)
+    AssertFatal(nas->uicc->pdu_sessions[i].id>0 && nas->uicc->pdu_sessions[i].id<16,"PDU session identity must be 1..15\n");
+  ue_policy_write_state(nas);
+  pthread_t thread;
+  AssertFatal(pthread_create(&thread,NULL,serve,nas)==0,"Cannot start UE policy service\n");
+  pthread_detach(thread);
+}
