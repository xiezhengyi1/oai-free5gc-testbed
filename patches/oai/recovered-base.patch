+  pthread_mutex_t qos_rules_lock;
+  nr_sdap_qos_rule_t qos_rules[NR_SDAP_MAX_QOS_RULES];
   struct sdap_tun_iface_s *next;
 } sdap_tun_iface_t;
 
@@ -58,7 +61,170 @@ void nr_sdap_tun_store_qfi(ue_id_t ue_id, int pdusession_id, uint8_t qfi)
   if (iface == NULL)
     return;
 
+  pthread_mutex_lock(&iface->qos_rules_lock);
   iface->qfi = qfi;
+  pthread_mutex_unlock(&iface->qos_rules_lock);
+}
+
+static int qos_rule_index(const nr_sdap_qos_rule_t *rules, uint8_t id)
+{
+  for (int i = 0; i < NR_SDAP_MAX_QOS_RULES; ++i) {
+    if (rules[i].active && rules[i].id == id)
+      return i;
+  }
+  return -1;
+}
+
+static int free_qos_rule_index(const nr_sdap_qos_rule_t *rules)
+{
+  for (int i = 0; i < NR_SDAP_MAX_QOS_RULES; ++i) {
+    if (!rules[i].active)
+      return i;
+  }
+  return -1;
+}
+
+int nr_sdap_tun_apply_qos_rules(
+    ue_id_t ue_id,
+    int pdusession_id,
+    const nr_sdap_qos_rule_t *updates,
+    size_t update_count)
+{
+  sdap_tun_iface_t *iface = sdap_tun_iface_lookup(ue_id, pdusession_id);
+  if (iface == NULL)
+    return -1;
+  pthread_mutex_lock(&iface->qos_rules_lock);
+  nr_sdap_qos_rule_t next[NR_SDAP_MAX_QOS_RULES];
+  memcpy(next, iface->qos_rules, sizeof(next));
+  for (size_t i = 0; i < update_count; ++i) {
+    const nr_sdap_qos_rule_t *update = &updates[i];
+    int index = qos_rule_index(next, update->id);
+    switch (update->operation) {
+      case 1:
+        if (index >= 0 || (index = free_qos_rule_index(next)) < 0)
+          goto invalid;
+        next[index] = *update;
+        next[index].active = true;
+        break;
+      case 2:
+        if (index < 0)
+          goto invalid;
+        memset(&next[index], 0, sizeof(next[index]));
+        break;
+      case 3:
+        if (index < 0 || next[index].packet_filter_count + update->packet_filter_count > NR_SDAP_MAX_PACKET_FILTERS)
+          goto invalid;
+        memcpy(&next[index].packet_filters[next[index].packet_filter_count],
+               update->packet_filters,
+               update->packet_filter_count * sizeof(update->packet_filters[0]));
+        next[index].packet_filter_count += update->packet_filter_count;
