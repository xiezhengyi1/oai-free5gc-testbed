+void nr_rrc_apply_rfsp(gNB_RRC_INST *rrc, const ngap_rfsp_update_t *update)
+{
+  const nr_rfsp_profile_t *profile = NULL;
+  FOR_EACH_SEQ_ARR(nr_rfsp_profile_t *, candidate, &rrc->rfsp_profiles) {
+    if (candidate->index == update->rfsp_index) {
+      profile = candidate;
+      break;
+    }
+  }
+  rrc_gNB_ue_context_t *context = rrc_gNB_get_ue_context(rrc, update->gNB_ue_ngap_id);
+  if (!profile || !context) {
+    LOG_W(NR_RRC, "RFSP_RADIO ran_ue_id=%u rfsp=%u status=blocked reason=%s\n",
+          update->gNB_ue_ngap_id, update->rfsp_index, profile ? "ue_unavailable" : "unmapped_index");
+    return;
+  }
+  gNB_RRC_UE_t *ue = &context->ue_context;
+  nr_rrc_cell_container_t *source = rrc_get_pcell_for_ue(rrc, ue);
+  nr_rrc_cell_container_t *target = get_cell_by_cell_id(&rrc->cells, profile->target_cell_id);
+  const char *blocked = NULL;
+  if (!source || !target)
+    blocked = "cell_unavailable";
+  else if (ue->ho_context)
+    blocked = "handover_in_progress";
+  else if (!seq_arr_size(&ue->drbs))
+    blocked = "no_established_drb";
+  else if (source != target && source->assoc_id == target->assoc_id)
+    blocked = "requires_inter_du_handover";
+  for (int i = 0; !blocked && i < NR_RRC_TRANSACTION_IDENTIFIER_NUMBER; ++i)
+    if (ue->xids[i] != RRC_ACTION_NONE)
+      blocked = "reconfiguration_in_progress";
+  if (blocked) {
+    LOG_W(NR_RRC, "RFSP_RADIO ran_ue_id=%u rfsp=%u status=blocked reason=%s\n",
+          ue->rrc_ue_id, update->rfsp_index, blocked);
+    return;
+  }
+  LOG_I(NR_RRC,
+        "RFSP_RADIO ran_ue_id=%u rfsp=%u status=%s source_cell=%lu source_pci=%u source_ssb_arfcn=%d "
+        "target_cell=%lu target_pci=%u target_ssb_arfcn=%d\n",
+        ue->rrc_ue_id, update->rfsp_index, source == target ? "already_on_target" : "triggered",
+        source->info.cell_id, source->info.pci, get_ssb_arfcn(source),
+        target->info.cell_id, target->info.pci, get_ssb_arfcn(target));
+  if (source == target)
+    return;
+  nr_rrc_trigger_f1_ho(rrc, ue, source, target);
+  ue->ho_context->rfsp_index = update->rfsp_index;
+}
+
 void nr_rrc_finalize_ho(gNB_RRC_UE_t *ue)
 {
+  if (ue->ho_context->source && ue->ho_context->target) {
+    f1_ue_data_t data = cu_get_f1_ue_data(ue->rrc_ue_id);
+    data.handover_source_ue = 0;
+    data.handover_source_assoc_id = 0;
+    bool updated = cu_update_f1_ue_data(ue->rrc_ue_id, &data);
+    DevAssert(updated);
+  }
   if (ue->ho_context->source)
     free_byte_array(ue->ho_context->source->old_cgc);
   free_ho_ctx(ue->ho_context);
