+
+/* Reject an external DCI with impossible ACK timing before changing HARQ state.
+ * Keep the original scheduling assertions as internal invariants. */
+bool nr_ue_dl10_feedback_admissible(NR_UE_MAC_INST_t *mac, const dci_pdu_rel15_t *dci, nr_rnti_type_t rnti_type)
+{
+  if (rnti_type == TYPE_RA_RNTI_ || rnti_type == TYPE_SI_RNTI_
+      || get_FeedbackDisabled(mac->sc_info.downlinkHARQ_FeedbackDisabled_r17, dci->harq_pid.val))
+    return true;
+  if (!mac->current_DL_BWP)
+    return false;
+  const int scs = mac->current_DL_BWP->scs;
+  const uint16_t feedback = 1 + dci->pdsch_to_harq_feedback_timing_indicator.val
+                            + GET_NTN_UE_K_OFFSET(&mac->phy_config.config_req.ntn_config, scs);
+  const long minimum = GET_DURATION_RX_TO_TX(&mac->phy_config.config_req.ntn_config, scs);
+  if (feedback < minimum) {
+    LOG_W(NR_MAC, "Reject DCI 1_0 before HARQ admission: crnti=%04x rnti_type=%d harq=%d indicator=%d feedback=%u minimum=%ld\n",
+          mac->crnti, rnti_type, dci->harq_pid.val,
+          dci->pdsch_to_harq_feedback_timing_indicator.val, feedback, minimum);
+    return false;
+  }
+  return true;
 }
 
