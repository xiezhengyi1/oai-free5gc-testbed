+
+/* Validate the external DL-SCH envelope before HARQ ACK or MAC side effects.
+ * CRC16 can accept an erroneous codeword. Keep the parser's assertions as
+ * invariants; a structurally invalid received TB is never admitted to it.
+ * This checks the same subheader widths and CE sizes as the existing parser.
+ */
+bool nr_ue_mac_pdu_bounds_valid(uint8_t *pdu, int length)
+{
+  if (!pdu || length <= 0)
+    return false;
+  while (length > 0) {
+    const uint8_t lcid = ((const NR_MAC_SUBHEADER_FIXED *)pdu)->LCID;
+    uint16_t size = 0, header = 1;
+    if (lcid == DL_SCH_LCID_PADDING)
+      return true;
+    if (lcid <= 32 || lcid == DL_SCH_LCID_SP_SRS_ACTIVATION ||
+        lcid == DL_SCH_LCID_TCI_STATE_ACT_UE_SPEC_PDSCH ||
+        lcid == DL_SCH_LCID_APERIODIC_CSI_TRI_STATE_SUBSEL ||
+        lcid == DL_SCH_LCID_SP_CSI_RS_CSI_IM_RES_SET_ACT) {
+      const unsigned needed = (pdu[0] & 0x40) ? 3 : 2;
+      if ((unsigned)length < needed || !get_mac_len(pdu, length, &size, &header))
+        return false;
+    } else {
+      switch (lcid) {
+        case DL_SCH_LCID_RECOMMENDED_BITRATE:
+        case DL_SCH_LCID_SP_ZP_CSI_RS_RES_SET_ACT:
+        case DL_SCH_LCID_SP_CSI_REP_PUCCH_ACT:
+        case DL_SCH_LCID_TCI_STATE_IND_UE_SPEC_PDCCH: size = 2; break;
+        case DL_SCH_LCID_PUCCH_SPATIAL_RELATION_ACT: size = 3; break;
+        case DL_SCH_LCID_DUPLICATION_ACT:
+        case DL_SCH_LCID_SCell_ACT_1_OCT:
+        case DL_SCH_LCID_TA_COMMAND: size = 1; break;
+        case DL_SCH_LCID_SCell_ACT_4_OCT: size = 4; break;
+        case DL_SCH_LCID_CON_RES_ID: size = 6; break;
+        default: break; /* Existing parser consumes one byte for other LCIDs. */
+      }
+    }
+    if ((unsigned)length < (unsigned)header + size)
+      return false;
+    pdu += header + size;
+    length -= header + size;
+  }
+  return true;
+}
