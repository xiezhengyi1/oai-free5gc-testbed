uicc0 = {
  imsi = "{{ ue.supi | replace('imsi-', '') }}";
  key = "{{ ue.key }}";
  opc = "{{ ue.opc }}";
  pdu_sessions = (
{% for session in ue.sessions %}    { dnn = "{{ session.dnn }}"; nssai_sst = 0x{{ "%02x" | format((scenario.slices | selectattr('id', 'equalto', session.slice_id) | first).sst) }}; nssai_sd = 0x{{ (scenario.slices | selectattr('id', 'equalto', session.slice_id) | first).sd }}; }{% if not loop.last %},{% endif %}
{% endfor %}  );
};

position0 = {
  x = {{ (scenario.ran.gnbs | selectattr('id', 'equalto', ue.serving_gnb) | first).cells[0].position.x }};
  y = {{ (scenario.ran.gnbs | selectattr('id', 'equalto', ue.serving_gnb) | first).cells[0].position.y }};
  z = {{ (scenario.ran.gnbs | selectattr('id', 'equalto', ue.serving_gnb) | first).cells[0].position.z }};
};

