services:
  mongodb:
    image: mongo:4.4
    container_name: mongodb
    command: ["mongod", "--port", "27017"]
    volumes: ["mongodb-data:/data/db"]
    networks:
      sbi-net: {aliases: [db]}
  free5gc-nrf:
    image: free5gc/nrf:v4.2.3
    container_name: free5gc-nrf
    command: ["./nrf", "-c", "./config/nrfcfg.yaml"]
    environment: {DB_URI: "mongodb://db/free5gc", GIN_MODE: release}
    volumes:
      - ./free5gc-config/nrfcfg.yaml:/free5gc/config/nrfcfg.yaml:ro
      - ./free5gc-config/cert:/free5gc/cert:ro
    depends_on: [mongodb]
    networks:
      sbi-net: {aliases: [nrf.free5gc.org]}
{% set nf_configs = [('ausf','ausfcfg'), ('nssf','nssfcfg'), ('pcf','pcfcfg'), ('udm','udmcfg'), ('udr','udrcfg'), ('nef','nefcfg')] %}
{% for nf, config in nf_configs %}
  free5gc-{{ nf }}:
    image: free5gc/{{ nf }}:v4.2.3
    container_name: free5gc-{{ nf }}
    command: ["./{{ nf }}", "-c", "./config/{{ config }}.yaml"]
    environment: {GIN_MODE: release{% if nf in ['udr', 'pcf'] %}, DB_URI: "mongodb://db/free5gc"{% endif %}}
    volumes:
      - ./free5gc-config/{{ config }}.yaml:/free5gc/config/{{ config }}.yaml:ro
      - ./free5gc-config/cert:/free5gc/cert:ro
    depends_on: [free5gc-nrf{% if nf in ['udm', 'udr', 'pcf', 'nef'] %}, mongodb{% endif %}]
    networks:
      sbi-net: {aliases: [{{ nf }}.free5gc.org]}
{% endfor %}
  free5gc-amf:
    image: free5gc/amf:v4.2.3
    container_name: free5gc-amf
    command: ["./amf", "-c", "./config/amfcfg.yaml"]
    environment: {GIN_MODE: release}
    volumes:
      - ./free5gc-config/amfcfg.yaml:/free5gc/config/amfcfg.yaml:ro
      - ./free5gc-config/cert:/free5gc/cert:ro
    depends_on: [free5gc-nrf]
    networks:
      sbi-net:
        interface_name: sbi0
        ipv4_address: {{ scenario.core.amf.sbi_ip }}
        aliases: [amf.free5gc.org]
      n2-net:
        interface_name: n2
        ipv4_address: {{ scenario.core.amf.n2_ip }}
  free5gc-smf:
    image: free5gc/smf:v4.2.3
    container_name: free5gc-smf
    command: ["./smf", "-c", "./config/smfcfg.yaml", "-u", "./config/uerouting.yaml"]
    environment: {GIN_MODE: release}
    volumes:
      - ./free5gc-config/smfcfg.yaml:/free5gc/config/smfcfg.yaml:ro
      - ./free5gc-config/uerouting.yaml:/free5gc/config/uerouting.yaml:ro
      - ./free5gc-config/cert:/free5gc/cert:ro
    depends_on:
      - free5gc-nrf
{% for upf in scenario.core.upfs %}      - {{ upf.container }}
{% endfor %}
    networks:
      sbi-net:
        interface_name: sbi0
        ipv4_address: {{ scenario.core.smf.sbi_ip }}
        aliases: [smf.free5gc.org]
      n4-net:
        interface_name: n4
        ipv4_address: {{ scenario.core.smf.n4_ip }}
{% for upf in scenario.core.upfs %}
  {{ upf.container }}:
    image: free5gc/upf:v4.2.3
    container_name: {{ upf.container }}
    command: ["/bin/sh", "-c", "/bin/sh ./upf-iptables.sh && exec ./upf -c ./config/upfcfg.yaml"]
    cap_drop: [ALL]
    cap_add: [NET_ADMIN]
    sysctls: {net.ipv4.ip_forward: "1"}
    volumes:
      - ./free5gc-config/upfcfg-{{ upf.id }}.yaml:/free5gc/config/upfcfg.yaml:ro
      - ./free5gc-config/upf-iptables-{{ upf.id }}.sh:/free5gc/upf-iptables.sh:ro
    deploy:
      resources:
        limits: {cpus: "{{ scenario.resources.containers[upf.container].cpus }}", memory: "{{ scenario.resources.containers[upf.container].memory_mb }}M"}
    networks:
      n3-net: {interface_name: n3, ipv4_address: {{ upf.n3_ip }}}
      n4-net: {interface_name: n4, ipv4_address: {{ upf.n4_ip }}}
{% set site = scenario.sites | selectattr('id', 'equalto', upf.site_id) | first %}
{% if site.type == 'edge' %}      edge-n6-net: {interface_name: n6, ipv4_address: {{ upf.n6_ip }}}
{% else %}      cloud-n6-net: {interface_name: n6, ipv4_address: {{ upf.n6_ip }}}
{% endif %}
{% endfor %}
  free5gc-webui:
    image: free5gc/webui:v4.2.3
    container_name: free5gc-webui
    command: ["./webui", "-c", "./config/webuicfg.yaml"]
    environment: {GIN_MODE: release}
    volumes: ["./free5gc-config/webuicfg.yaml:/free5gc/config/webuicfg.yaml:ro"]
    ports: ["5000:5000"]
    depends_on: [mongodb, free5gc-nrf]
    networks:
      sbi-net: {aliases: [webui]}
  free5gc-chf:
    image: free5gc/chf:v4.2.3
    container_name: free5gc-chf
    command: ["./chf", "-c", "./config/chfcfg.yaml"]
    environment: {DB_URI: "mongodb://db/free5gc", GIN_MODE: release}
    volumes:
      - ./free5gc-config/chfcfg.yaml:/free5gc/config/chfcfg.yaml:ro
      - ./free5gc-config/cert:/free5gc/cert:ro
    depends_on: [mongodb, free5gc-nrf, free5gc-webui]
    networks:
      sbi-net: {aliases: [chf.free5gc.org]}
