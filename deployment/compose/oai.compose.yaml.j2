services:
{% for gnb in scenario.ran.gnbs %}
  {{ gnb.container }}:
    image: oaisoftwarealliance/oai-gnb:v2.4.0
    container_name: {{ gnb.container }}
    cap_drop: [ALL]
    cap_add: [SYS_NICE]
    environment:
      USE_ADDITIONAL_OPTIONS: "-E --rfsim --log_config.global_log_options level,nocolor,time"
      ASAN_OPTIONS: "detect_leaks=0"
    volumes: ["./oai-config/{{ gnb.id }}.conf:/opt/oai-gnb/etc/gnb.conf:ro"]
    deploy:
      resources:
        limits: {cpus: "{{ scenario.resources.containers[gnb.container].cpus }}", memory: "{{ scenario.resources.containers[gnb.container].memory_mb }}M"}
    depends_on: [free5gc-amf, free5gc-smf]
    healthcheck:
      test: ["CMD-SHELL", "pgrep nr-softmodem"]
      start_period: 10s
      interval: 5s
      timeout: 3s
      retries: 60
    networks:
      n2-net: {interface_name: n2, ipv4_address: {{ gnb.n2_ip }}}
      n3-net: {interface_name: n3, ipv4_address: {{ gnb.n3_ip }}}
      control-net: {}
{% endfor %}
{% for ue in scenario.ues %}
{% set serving_gnb = scenario.ran.gnbs | selectattr('id', 'equalto', ue.serving_gnb) | first %}
  {{ ue.container }}:
    image: oaisoftwarealliance/oai-nr-ue:v2.4.0
    container_name: {{ ue.container }}
    cap_drop: [ALL]
    cap_add: [NET_ADMIN, NET_RAW, SYS_NICE]
    devices: ["/dev/net/tun:/dev/net/tun"]
    environment:
      USE_ADDITIONAL_OPTIONS: "-E --sa --rfsim -r {{ scenario.ran.bandwidth_rb }} --numerology {{ scenario.ran.numerology }} --band {{ scenario.ran.band }} -C {{ scenario.ran.frequency_hz }} --ssb {{ scenario.ran.ssb_arfcn }} --rfsimulator.serveraddr {{ serving_gnb.container }} --log_config.global_log_options level,nocolor,time"
    volumes: ["./oai-config/{{ ue.id }}.conf:/opt/oai-nr-ue/etc/nr-ue.conf:ro"]
    deploy:
      resources:
        limits: {cpus: "{{ scenario.resources.containers[ue.container].cpus }}", memory: "{{ scenario.resources.containers[ue.container].memory_mb }}M"}
    depends_on: [{{ serving_gnb.container }}]
    healthcheck:
      test: ["CMD-SHELL", "pgrep nr-uesoftmodem && ip link show oaitun_ue1"]
      start_period: 20s
      interval: 5s
      timeout: 3s
      retries: 60
    networks:
      n2-net: {}
      monitoring-net: {}
      control-net: {}
  {{ ue.traffic_sidecar }}:
    image: oai-free5gc-testbed/traffic-sidecar:0.1.0
    container_name: {{ ue.traffic_sidecar }}
    network_mode: "service:{{ ue.container }}"
    cap_drop: [ALL]
    cap_add: [NET_RAW]
    environment:
      RUN_ID: {{ run_id }}
      UE_ID: {{ ue.id }}
      TRAFFIC_PROFILE_PATH: /run/traffic-profiles.json
    volumes: ["./traffic-profiles.json:/run/traffic-profiles.json:ro"]
    depends_on:
      {{ ue.container }}: {condition: service_healthy}
{% endfor %}
